<Window x:Class="CodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Text.WindowTitle}"
        Icon="assets/app.ico"
        Width="510"
        Height="315"
        MinWidth="510"
        MaxWidth="510"
        MinHeight="315"
        MaxHeight="315"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Loaded="MainWindowLoaded"
        Closing="MainWindowClosing"
        Closed="MainWindowClosed">
    <Grid Margin="10">
        <TabControl Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}">
            <TabItem Header="{Binding Text.DashboardTab}">
                <Border Padding="12,10" Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="Codex" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Margin="7,0,0,0" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#333333" CornerRadius="3">
                                <TextBlock Text="{Binding PlanName}" FontSize="12" Foreground="#C8C8C8" />
                            </Border>
                            <Button Grid.Column="3" Width="92" Height="23" Padding="5,0" Content="{Binding Text.RefreshNow}" ToolTip="{Binding StatusText}" Click="RefreshClicked" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding FiveHourVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5h" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding FiveHourPercent, Mode=OneWay}" Background="#333333" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding FiveHourPercentText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding FiveHourResetText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,5,0,0" Visibility="{Binding SevenDayVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="7d" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding SevenDayPercent, Mode=OneWay}" Background="#333333" Foreground="{StaticResource WeeklyBrush}" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding SevenDayPercentText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding SevenDayResetText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding MembershipText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" MinWidth="24" Height="19" Margin="8,0,0,0" Padding="5,0" Background="{StaticResource SuccessBrush}" CornerRadius="9" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResetCreditsDisplayText}" FontSize="12" Foreground="#15221F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Text.SettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10">
                        <Button HorizontalAlignment="Left" MinWidth="110" Height="26" Padding="8,0" Content="{Binding Text.RefreshNow}" Click="RefreshClicked" />

                        <TextBlock Margin="0,12,0,4" Text="{Binding Text.RefreshInterval}" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="RefreshIntervalComboBox" Height="26" SelectionChanged="RefreshIntervalSelectionChanged">
                            <ComboBoxItem Tag="5" Content="{Binding Text.Interval5Seconds}" />
                            <ComboBoxItem Tag="10" Content="{Binding Text.Interval10Seconds}" />
                            <ComboBoxItem Tag="30" Content="{Binding Text.Interval30Seconds}" />
                            <ComboBoxItem Tag="60" Content="{Binding Text.Interval60Seconds}" />
                            <ComboBoxItem Tag="120" Content="{Binding Text.Interval120Seconds}" />
                        </ComboBox>

                        <TextBlock Margin="0,12,0,4" Text="{Binding Text.MembershipExpiry}" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="MembershipExpiryTextBox" Height="26" ToolTip="{Binding Text.MembershipExpiryPlaceholder}" />
                        <TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                            <Run Text="{Binding Text.MembershipExpiryPlaceholder}" />
                            <LineBreak />
                            <Run Text="{Binding Text.MembershipExpiryHint}" />
                        </TextBlock>
                        <Button HorizontalAlignment="Left" MinWidth="80" Height="26" Padding="8,0" Content="{Binding Text.Save}" Click="SaveMembershipExpiryClicked" />

                        <TextBlock Margin="0,12,0,4" Text="{Binding Text.Language}" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="LanguageComboBox" Height="26" SelectionChanged="LanguageSelectionChanged">
                            <ComboBoxItem Tag="SimplifiedChinese" Content="{Binding Text.SimplifiedChinese}" />
                            <ComboBoxItem Tag="English" Content="{Binding Text.English}" />
                        </ComboBox>

                        <CheckBox x:Name="LaunchAtLoginCheckBox" Margin="0,12,0,0" Content="{Binding Text.LaunchAtLogin}" Checked="LaunchAtLoginChanged" Unchecked="LaunchAtLoginChanged" />
                        <TextBlock x:Name="SettingsStatusTextBlock" Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
