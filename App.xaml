<Application x:Class="CodexQuotaWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9D9D9D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6F6F6F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="WeeklyBrush" Color="#8B8BB8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4EC9B0" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="Foreground" Value="#D4D4D4" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="#D4D4D4" />
        </Style>
    </Application.Resources>
</Application>
